[Unit]
Description=MindGate enforcement daemon
Wants=systemd-logind.service
After=network.target dbus.service systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mindgated
Restart=always
RestartSec=2

# Kill the whole cgroup on stop, not just the main PID, so a forced
# stop can't leave orphaned child processes behind.
KillMode=control-group

# Root is required: the daemon needs to send signals to browser processes
# owned by other users (via pkill in guardian.rs).
User=root

# Written by install.sh — MINDGATE_OWNER_UID identifies the real human
# who installed MindGate, so authorized() in server.rs can let their
# own unprivileged processes (the CLI without sudo, and critically the
# browser extension's native-messaging bridge) talk to this socket
# even though the daemon itself runs as root with no sudo layer of its
# own to read a SUDO_UID from. The leading '-' means "don't fail unit
# startup if this file doesn't exist yet."
EnvironmentFile=-/etc/mindgate/owner.env

[Install]
WantedBy=multi-user.target