[Unit]
Description=MindGate Website Blocker v2
Documentation=https://github.com/FrenzyDev-git/MindGate
After=network.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mindgate.py start
RemainAfterExit=yes
Restart=always
RestartSec=10
RestartForceExitStatus=1
StandardOutput=journal
StandardError=journal
User=root

[Install]
WantedBy=multi-user.target
