{
  "manifest_version": 3,
  "name": "MindGate",
  "short_name": "MindGate",
  "description": "Block distracting websites with a calm, premium blocker powered by the MindGate daemon.",
  "version": "0.1.0",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "protector@mindgate.local"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["block.html", "block.js"],
      "matches": ["<all_urls>"]
    }
  ]
}